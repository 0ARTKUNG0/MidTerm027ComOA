# Frontend Environment Configuration
# Note: All variables must start with REACT_APP_ to be accessible in React

# API Configuration
REACT_APP_API_BASE_URL=https://your-render-backend-url.com/api
REACT_APP_BACKEND_URL=https://your-render-backend-url.com

# App Configuration
REACT_APP_NAME=Software Download Manager
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Find and download your favorite software

# Development Configuration
REACT_APP_DEBUG=false